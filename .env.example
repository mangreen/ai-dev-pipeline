# Only needed to try tools/scripts/notify.sh on your own machine.
# In GitHub Actions these come from repository secrets, not from a file.
# FIXME: Replace the placeholders locally; never commit the real values.

# Slack incoming webhook URL of the channel that receives notifications. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=

# Microsoft Teams (Workflows) webhook URL. Leave empty to skip Teams.
TEAMS_WEBHOOK_URL=

# Path of the owner map (GitHub login -> Slack ID / Teams email). Default shown.
MAP_FILE=.github/notify-owners.json

# Set to 1 to print the payloads instead of sending them.
NOTIFY_DRY_RUN=1
